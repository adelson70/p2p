---
import type { Locale } from '@/i18n/config';
import { localePath } from '@/i18n/config';
import { getDictionary } from '@/i18n';
import type { ToolDefinition } from '@/tools/registry';

interface Props {
  locale: Locale;
  tool: ToolDefinition;
}

const { locale, tool } = Astro.props;
const dict = getDictionary(locale);
const entry = dict.toolEntries[tool.i18nKey as keyof typeof dict.toolEntries];
const href =
  tool.status === 'live' && tool.path ? localePath(locale, `/${tool.path}`) : undefined;
const liveClass =
  tool.status === 'live' ? 'border-accent/30 bg-accent-muted text-accent' : '';
---

{
  href ? (
    <a href={href} class="block transition-opacity hover:opacity-90">
      <div class="h-full rounded-xl border border-border bg-surface p-5 shadow-sm">
        <div class="flex items-start justify-between gap-2">
          <h3 class="font-medium text-foreground">{entry.name}</h3>
          <span
            class:list={[
              'inline-flex items-center rounded-md border border-border bg-surface-raised px-2 py-0.5 text-xs font-medium text-muted',
              liveClass,
            ]}
          >
            {tool.status === 'live' ? dict.tools.live : dict.tools.soon}
          </span>
        </div>
        <p class="mt-2 text-sm text-muted">{entry.description}</p>
      </div>
    </a>
  ) : (
    <div class="h-full rounded-xl border border-border bg-surface p-5 opacity-80 shadow-sm">
      <div class="flex items-start justify-between gap-2">
        <h3 class="font-medium text-foreground">{entry.name}</h3>
        <span class="inline-flex items-center rounded-md border border-border bg-surface-raised px-2 py-0.5 text-xs font-medium text-muted">
          {dict.tools.soon}
        </span>
      </div>
      <p class="mt-2 text-sm text-muted">{entry.description}</p>
    </div>
  )
}
