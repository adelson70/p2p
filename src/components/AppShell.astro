---
import type { Locale } from '@/i18n/config';
import { localePath } from '@/i18n/config';
import { getDictionary } from '@/i18n';
import { LocaleSwitcher } from '@/components/LocaleSwitcher';
import { MobileBottomNav } from '@/components/MobileBottomNav';

interface Props {
  locale: Locale;
  currentPath?: string;
  /** Full-height main (e.g. PrivateChat thread); hides footer padding */
  fillMain?: boolean;
}

const { locale, currentPath = '', fillMain = false } = Astro.props as Props;
const dict = getDictionary(locale);

const navItems = [
  { key: 'home' as const, path: '' },
  { key: 'tools' as const, path: '/tools' },
  { key: 'transfer' as const, path: '/transfer' },
  { key: 'communication' as const, path: '/communication' },
  { key: 'collaboration' as const, path: '/collaboration' },
  { key: 'history' as const, path: '/history' },
  { key: 'settings' as const, path: '/settings' },
  { key: 'blog' as const, path: '/blog' },
];
---

<div
  class:list={[
    'app-shell flex flex-col md:flex-row',
    fillMain ? 'app-shell--fill min-h-dvh md:min-h-dvh' : 'min-h-dvh',
  ]}
  data-fill-main={fillMain || undefined}
>
  <header
    class="app-mobile-header z-30 flex shrink-0 items-center justify-between gap-2 border-b border-border bg-surface px-4 py-3 md:hidden"
  >
    <a href={localePath(locale, '/')} class="font-semibold tracking-tight">
      {dict.meta.siteName}
    </a>
    <LocaleSwitcher client:load locale={locale} currentPath={currentPath} />
  </header>

  <aside
    class="hidden border-border bg-surface md:flex md:w-56 md:shrink-0 md:flex-col md:border-r"
  >
    <div class="flex flex-col items-stretch gap-2 px-4 py-4">
      <a href={localePath(locale, '/')} class="font-semibold tracking-tight">
        {dict.meta.siteName}
      </a>
      <LocaleSwitcher client:load locale={locale} currentPath={currentPath} />
    </div>
    <nav class="flex flex-col gap-1 overflow-visible px-3 pb-6">
      {
        navItems.map((item) => {
          const href = localePath(locale, item.path || '/');
          const active =
            item.path === ''
              ? currentPath === '' || currentPath === '/'
              : currentPath.startsWith(item.path);
          return (
            <a
              href={href}
              class:list={[
                'whitespace-nowrap rounded-lg px-3 py-2 text-sm transition-colors',
                active
                  ? 'bg-accent-muted text-accent'
                  : 'text-muted hover:bg-white/5 hover:text-foreground',
              ]}
            >
              {dict.nav[item.key]}
            </a>
          );
        })
      }
    </nav>
  </aside>

  <div class="flex min-h-0 flex-1 flex-col md:flex-row md:overflow-visible">
    <div class="app-shell-scroll flex min-h-0 flex-1 flex-col md:overflow-visible">
      <main
        class:list={[
          'app-main flex min-h-0 flex-col md:flex-1',
          fillMain ? 'p-0' : 'app-main--padded px-4 py-6 md:px-8 md:py-10',
        ]}
      >
        {
          fillMain ? (
            <div class="fill-main-host fill-main-host--scroll">
              <slot />
            </div>
          ) : (
            <div class="mx-auto flex w-full max-w-5xl flex-col items-center">
              <div class="w-full">
                <slot />
              </div>
            </div>
          )
        }
      </main>
      {
        !fillMain ? (
          <footer class="app-footer shrink-0 border-t border-border px-4 py-4 text-center text-xs text-muted md:px-8">
            {dict.footer.privacy}
          </footer>
        ) : null
      }
    </div>
  </div>

  <MobileBottomNav client:idle locale={locale} currentPath={currentPath} />
</div>
