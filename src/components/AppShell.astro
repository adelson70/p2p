---
import type { Locale } from '@/i18n/config';
import { localePath } from '@/i18n/config';
import { getDictionary } from '@/i18n';
import { LocaleSwitcher } from '@/components/LocaleSwitcher';

interface Props {
  locale: Locale;
  currentPath?: string;
  /** Full-height main (e.g. PrivateChat thread); hides footer padding */
  fillMain?: boolean;
}

const { locale, currentPath = '', fillMain = false } = Astro.props;
const dict = getDictionary(locale);

const navItems = [
  { key: 'home' as const, path: '' },
  { key: 'tools' as const, path: '/tools' },
  { key: 'transfer' as const, path: '/transfer' },
  { key: 'communication' as const, path: '/communication' },
  { key: 'collaboration' as const, path: '/collaboration' },
  { key: 'history' as const, path: '/history' },
  { key: 'settings' as const, path: '/settings' },
  { key: 'blog' as const, path: '/blog' },
];
---

<div
  class:list={[
    'flex flex-col md:flex-row',
    fillMain ? 'h-dvh max-h-dvh overflow-hidden' : 'min-h-dvh',
  ]}
  data-fill-main={fillMain || undefined}
>
  <aside class="border-b border-border bg-surface md:w-56 md:shrink-0 md:border-b-0 md:border-r">
    <div class="flex items-center justify-between gap-2 px-4 py-4 md:flex-col md:items-stretch">
      <a href={localePath(locale, '/')} class="font-semibold tracking-tight">
        {dict.meta.siteName}
      </a>
      <LocaleSwitcher client:load locale={locale} currentPath={currentPath} />
    </div>
    <nav class="flex gap-1 overflow-x-auto px-2 pb-3 md:flex-col md:overflow-visible md:px-3 md:pb-6">
      {
        navItems.map((item) => {
          const href = localePath(locale, item.path || '/');
          const active =
            item.path === ''
              ? currentPath === '' || currentPath === '/'
              : currentPath.startsWith(item.path);
          return (
            <a
              href={href}
              class:list={[
                'whitespace-nowrap rounded-lg px-3 py-2 text-sm transition-colors',
                active
                  ? 'bg-accent-muted text-accent'
                  : 'text-muted hover:bg-white/5 hover:text-foreground',
              ]}
            >
              {dict.nav[item.key]}
            </a>
          );
        })
      }
    </nav>
  </aside>
  <div class="flex min-h-0 flex-1 flex-col">
    <main
      class:list={[
        'flex min-h-0 flex-1 flex-col',
        fillMain ? 'overflow-hidden p-0' : 'px-4 py-6 md:px-8 md:py-10',
      ]}
    >
      {
        fillMain ? (
          <div class="fill-main-host">
            <slot />
          </div>
        ) : (
          <div class="mx-auto flex w-full max-w-5xl flex-col items-center">
            <div class="w-full">
              <slot />
            </div>
          </div>
        )
      }
    </main>
    {
      !fillMain ? (
        <footer class="border-t border-border px-4 py-4 text-center text-xs text-muted md:px-8">
          {dict.footer.privacy}
        </footer>
      ) : null
    }
  </div>
</div>
