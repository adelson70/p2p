---
import BaseLayout from './BaseLayout.astro';
import AppShell from '@/components/AppShell.astro';
import type { Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n';

interface Props {
  locale: Locale;
  currentPath?: string;
  title?: string;
  description?: string;
  fillMain?: boolean;
}

const { locale, currentPath = '', title, description, fillMain = false } = Astro.props;
const dict = getDictionary(locale);
const pageTitle = title ? `${title} · ${dict.meta.siteName}` : dict.meta.siteName;
const pageDesc = description ?? dict.meta.description;
---

<BaseLayout
  locale={locale}
  title={pageTitle}
  description={pageDesc}
  canonicalPath={currentPath || '/'}
>
  <AppShell locale={locale} currentPath={currentPath} fillMain={fillMain}>
    <slot />
  </AppShell>
</BaseLayout>
