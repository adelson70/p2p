---
import '@/styles/global.css';
import type { Locale } from '@/i18n/config';
import { alternateLocales, localeDefinitions, localePath } from '@/i18n/config';
import { AdblockGate } from '@/components/AdblockGate.tsx';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  canonicalPath?: string;
}

const { locale, title, description, canonicalPath = '' } = Astro.props;
const site = Astro.site?.href?.replace(/\/$/, '') ?? '';
const canonical = `${site}${localePath(locale, canonicalPath || '/')}`;
const dictDesc = description;
const htmlLang = localeDefinitions[locale].bcp47;
const htmlDir = localeDefinitions[locale].direction;
const ogLocale =
  locale === 'en' ? 'en_US' : locale === 'pt' ? 'pt_BR' : locale === 'zh' ? 'zh_CN' : `${locale}_${locale.toUpperCase()}`;
const defaultCanonical = `${site}${localePath('en', canonicalPath || '/')}`;
const adblockGateEnabled = !import.meta.env.DEV;
---

<!doctype html>
<html lang={htmlLang} dir={htmlDir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=overlays-content" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {dictDesc ? <meta name="description" content={dictDesc} /> : null}
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={defaultCanonical} />
    {
      alternateLocales(locale).map((alt) => (
        <link
          rel="alternate"
          hreflang={localeDefinitions[alt].bcp47}
          href={`${site}${localePath(alt, canonicalPath || '/')}`}
        />
      ))
    }
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Private Tools blog"
      href={`${site}/rss.xml`}
    />
    <meta property="og:title" content={title} />
    {dictDesc ? <meta property="og:description" content={dictDesc} /> : null}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {
      alternateLocales(locale).map((alt) => (
        <meta
          property="og:locale:alternate"
          content={
            alt === 'en' ? 'en_US' : alt === 'pt' ? 'pt_BR' : alt === 'zh' ? 'zh_CN' : `${alt}_${alt.toUpperCase()}`
          }
        />
      ))
    }
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    {dictDesc ? <meta name="twitter:description" content={dictDesc} /> : null}
    <meta name="theme-color" content="#09090b" />
    <slot name="head" />
    <script is:inline>
      {`(function () {
  function recover() {
    if (!window.matchMedia('(max-width: 767px)').matches) return;
    if (document.visibilityState && document.visibilityState !== 'visible') return;
    var root = document.documentElement;
    if (!root.classList.contains('pt-adblock')) {
      root.style.removeProperty('--app-vh');
      root.style.height = '';
      root.style.overflow = '';
      document.body.style.height = '';
      document.body.style.overflow = '';
      document.body.style.position = '';
      document.body.style.width = '';
      document.body.style.top = '';
    }
  }
  document.addEventListener('visibilitychange', function () {
    if (document.visibilityState === 'visible') {
      recover();
      requestAnimationFrame(recover);
      setTimeout(recover, 100);
    }
  });
  window.addEventListener('pageshow', recover);
  window.addEventListener('focus', recover);
})();`}
    </script>
    <script is:inline>
      (function () {
        try {
          var raw = localStorage.getItem('pt_prefs');
          var theme = raw ? JSON.parse(raw).theme : 'system';
          if (theme === 'dark' || theme === 'light') {
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (e) {}
      })();
    </script>
    {
      import.meta.env.DEV && (
        <script is:inline>
          {`if ('serviceWorker' in navigator) {
            navigator.serviceWorker.getRegistrations().then(function (regs) {
              regs.forEach(function (r) { r.unregister(); });
            });
          }`}
        </script>
      )
    }
  </head>
  <body>
    {
      adblockGateEnabled ? (
        <>
          <script is:inline>
            {`(function () {
  function cosmeticBlocked() {
    var host = document.body;
    if (!host) return false;
    var wrap = document.createElement('div');
    wrap.style.cssText =
      'position:absolute;left:0;top:0;width:1px;height:1px;overflow:hidden;pointer-events:none;z-index:-1;';
    var el = document.createElement('div');
    el.innerHTML = '&nbsp;';
    el.className =
      'pub_300x250 pub_300x250m pub_728x90 text-ad textAd text_ad text_ads text-ads text-ad-links advertisement sponsored-content adsbox ad-placement';
    el.style.cssText = 'display:block;width:1px;height:1px;';
    wrap.appendChild(el);
    host.appendChild(wrap);
    var cs = window.getComputedStyle(el);
    var blocked =
      el.offsetHeight === 0 ||
      el.offsetWidth === 0 ||
      cs.display === 'none' ||
      cs.visibility === 'hidden' ||
      cs.opacity === '0';
    wrap.remove();
    return blocked;
  }
  function apply(blocked) {
    window.__PT_ADBLOCK = blocked;
    if (blocked) {
      document.documentElement.classList.add('pt-adblock');
      document.documentElement.style.overflow = 'hidden';
    } else {
      document.documentElement.classList.remove('pt-adblock');
      document.documentElement.style.overflow = '';
    }
  }
  function run() {
    apply(cosmeticBlocked());
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run);
  } else {
    run();
  }
})();`}
          </script>
          <AdblockGate client:load locale={locale} />
        </>
      ) : null
    }
    <slot />
  </body>
</html>
