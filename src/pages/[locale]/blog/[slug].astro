---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import { getDictionary } from '@/i18n';
import { localePath, localeToIntlTag } from '@/i18n/config';
import { getCollection } from 'astro:content';
import { blogSlugFromId, isPublished } from '@/utils/blog';
import { localizeHtmlLinks } from '@/utils/localizeMarkdownLinks';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter(isPublished)
    .map((post) => ({
      params: {
        locale: post.data.locale,
        slug: blogSlugFromId(post.id),
      },
      props: { post },
    }));
}

interface Props {
  post: import('astro:content').CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const locale = post.data.locale;
const dict = getDictionary(locale);
const slug = blogSlugFromId(post.id);
const title = post.data.title;
const description = post.data.description;
const canonicalPath = `/blog/${slug}`;

const articleHtml = localizeHtmlLinks(post.rendered?.html ?? '', locale);

const site = Astro.site?.href?.replace(/\/$/, '') ?? '';
const dateFmt = new Intl.DateTimeFormat(localeToIntlTag(locale), {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<MarketingLayout {locale} {title} {description} {canonicalPath}>
  <JsonLd
    slot="head"
    data={{
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: post.data.pubDate.toISOString(),
      dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
      url: `${site}${localePath(locale, canonicalPath)}`,
      author: { '@type': 'Organization', name: dict.meta.siteName },
      publisher: { '@type': 'Organization', name: dict.meta.siteName },
    }}
  />
  <meta slot="head" property="og:type" content="article" />
  <meta slot="head" property="article:published_time" content={post.data.pubDate.toISOString()} />
  <article class="prose prose-invert max-w-none prose-headings:font-semibold prose-p:text-muted prose-a:text-accent">
    <p class="not-prose text-sm text-muted">
      <time datetime={post.data.pubDate.toISOString()}>{dateFmt.format(post.data.pubDate)}</time>
    </p>
    <h1>{title}</h1>
    <div set:html={articleHtml} />
    <section class="not-prose mt-12 rounded-xl border border-border bg-surface/40 p-6">
      <h2 class="text-lg font-semibold text-foreground">{dict.blog.tryToolsTitle}</h2>
      <p class="mt-2 text-sm text-muted">{dict.blog.tryToolsBody}</p>
      <ul class="mt-4 list-inside list-disc text-sm text-accent">
        <li>
          <a href={localePath(locale, '/transfer')}>{dict.blog.linkPrivateDrop}</a>
        </li>
        <li>
          <a href={localePath(locale, '/communication/privatechat')}>{dict.blog.linkPrivateChat}</a>
        </li>
        <li>
          <a href={localePath(locale, '/send-large-files')}>{dict.blog.linkSendLarge}</a>
        </li>
      </ul>
      <p class="mt-6">
        <a class="text-sm text-accent hover:underline" href={localePath(locale, '/blog')}>
          {dict.blog.backToBlog}
        </a>
      </p>
    </section>
  </article>
</MarketingLayout>
