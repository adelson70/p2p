---
import type { Locale } from '@/i18n/config';
import { localePath } from '@/i18n/config';
import { buildLocalePaths, resolvePageLocale } from '@/i18n/astro';

export function getStaticPaths() {
  return buildLocalePaths();
}

const locale = resolvePageLocale(Astro.params.locale);
if (!locale) return Astro.redirect('/en/');

return Astro.redirect(localePath(locale, '/transfer'));
---
