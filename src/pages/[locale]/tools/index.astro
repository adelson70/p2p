---
import HubLayout from '@/layouts/HubLayout.astro';
import { ToolsDirectory } from '@/features/tools/ToolsDirectory';
import type { Locale } from '@/i18n/config';

import { buildLocalePaths, resolvePageLocale } from '@/i18n/astro';
export function getStaticPaths() {
  return buildLocalePaths();
}
const locale = resolvePageLocale(Astro.params.locale);
if (!locale) return Astro.redirect('/en/');
---

<HubLayout locale={locale} currentPath="/tools">
  <ToolsDirectory client:load locale={locale} />
</HubLayout>
