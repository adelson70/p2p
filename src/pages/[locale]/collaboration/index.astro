---
import HubLayout from '@/layouts/HubLayout.astro';
import ToolCard from '@/components/ToolCard.astro';
import type { Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n';
import { toolsByCategory } from '@/tools/registry';
import { buildLocalePaths, resolvePageLocale } from '@/i18n/astro';

export function getStaticPaths() {
  return buildLocalePaths();
}

const locale = resolvePageLocale(Astro.params.locale);
if (!locale) return Astro.redirect('/en/');
const dict = getDictionary(locale);
const collaborationTools = toolsByCategory('collaboration');
---

<HubLayout locale={locale} currentPath="/collaboration">
  <header class="mb-8 space-y-2 text-center">
    <h1 class="text-2xl font-semibold tracking-tight md:text-3xl">{dict.collaboration.title}</h1>
    <p class="mx-auto max-w-2xl text-muted">{dict.collaboration.subtitle}</p>
  </header>
  <div class="grid gap-4 sm:grid-cols-2">
    {collaborationTools.map((tool) => (
      <ToolCard locale={locale} tool={tool} />
    ))}
  </div>
</HubLayout>
