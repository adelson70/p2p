---
import HubLayout from '@/layouts/HubLayout.astro';
import { SettingsPanel } from '@/features/settings/SettingsPanel';
import type { Locale } from '@/i18n/config';

import { buildLocalePaths, resolvePageLocale } from '@/i18n/astro';
export function getStaticPaths() {
  return buildLocalePaths();
}
const locale = resolvePageLocale(Astro.params.locale);
if (!locale) return Astro.redirect('/en/');
---

<HubLayout locale={locale} currentPath="/settings">
  <SettingsPanel client:load locale={locale} />
</HubLayout>
