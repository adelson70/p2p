---
import HubLayout from '@/layouts/HubLayout.astro';
import { PrivateCallApp } from '@/tools/privatecall/PrivateCallApp';
import type { Locale } from '@/i18n/config';

import { buildLocalePaths, resolvePageLocale } from '@/i18n/astro';
export function getStaticPaths() {
  return buildLocalePaths();
}
const locale = resolvePageLocale(Astro.params.locale);
if (!locale) return Astro.redirect('/en/');
---

<HubLayout locale={locale} currentPath="/communication/privatecall" fillMain>
  <PrivateCallApp client:visible locale={locale} />
</HubLayout>
